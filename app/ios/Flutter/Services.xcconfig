// Official Google sample app. Production uses Services.local.xcconfig plus Dart config.
POURLUNE_ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
POURLUNE_FIREBASE_ENV = none
POURLUNE_FIREBASE_INPUTS = $(SRCROOT)/Flutter/Firebase.none.xcfilelist
POURLUNE_FIREBASE_SYMBOL_INPUTS = $(SRCROOT)/Flutter/Firebase.none.xcfilelist
POURLUNE_FIREBASE_UPLOAD_SYMBOLS = NO

POURLUNE_DISPLAY_NAME = Pourlune Dev

// Runner-only settings consume these; SPM resource bundles receive no profile.
POURLUNE_CODE_SIGN_STYLE = Automatic
POURLUNE_CODE_SIGN_IDENTITY = iPhone Developer
POURLUNE_PROVISIONING_PROFILE =

POURLUNE_BUNDLE_IDENTIFIER = dev.pourlune.pourluneDev
