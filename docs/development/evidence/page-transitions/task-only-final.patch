+      final other = dates
+          .evaluate()
+          .map((e) => (e.widget.key! as ValueKey<String>).value)
+          .firstWhere((key) => key != 'date-${c.today.date}');
+      await t.ensureVisible(find.byKey(Key(other)));
+      await t.tap(find.byKey(Key(other)));
