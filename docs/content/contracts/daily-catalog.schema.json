{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pourlune daily catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_version", "epoch_date", "puzzle_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_version": {"type": "integer", "minimum": 1},
    "epoch_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "puzzle_ids": {
      "type": "array", "minItems": 30, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^daily-[a-z0-9-]+$"}
    }
  }
}
