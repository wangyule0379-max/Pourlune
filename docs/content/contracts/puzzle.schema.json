{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pourlune puzzle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "puzzle_id", "content_version", "mode", "content_status", "main_level", "capacity", "initial_bottom_to_top", "target_labels", "reference_moves", "difficulty_intent"],
  "properties": {
    "schema_version": {"const": 1},
    "puzzle_id": {"type": "string", "pattern": "^(main-[0-9]{3}|daily-[a-z0-9-]+)$"},
    "content_version": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["main", "daily"]},
    "content_status": {"enum": ["reference_fixture", "production_candidate"]},
    "main_level": {"type": ["integer", "null"], "minimum": 1, "maximum": 60},
    "capacity": {"const": 4},
    "initial_bottom_to_top": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": {"type": "array", "maxItems": 4, "items": {"enum": ["O", "G", "P", "B"]}}
    },
    "target_labels": {
      "type": "array", "minItems": 4, "maxItems": 6,
      "items": {"enum": ["O", "G", "P", "B", null]}
    },
    "reference_moves": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_index", "to_index"],
        "properties": {
          "from_index": {"type": "integer", "minimum": 0, "maximum": 5},
          "to_index": {"type": "integer", "minimum": 0, "maximum": 5}
        }
      }
    },
    "difficulty_intent": {"type": "string", "minLength": 1},
    "source_reference": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "main"}}},
      "then": {"properties": {"main_level": {"type": "integer"}, "puzzle_id": {"pattern": "^main-[0-9]{3}$"}}},
      "else": {"properties": {"main_level": {"type": "null"}, "puzzle_id": {"pattern": "^daily-[a-z0-9-]+$"}}}
    }
  ]
}
